APP_NAME="Caça ao Tesouro RA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMINIO__

# endereço público (o Caddy emite o certificado HTTPS para ele)
DOMINIO=__DOMINIO__

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=__DB_PASSWORD__
DB_ROOT_PASSWORD=__DB_ROOT_PASSWORD__

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true

# senha do usuário professor criada pelo seeder
SENHA_PROFESSOR=__SENHA_PROFESSOR__

# componente de IA (container "ia"). Sem modelo treinado as dicas usam a regra de distância.
# IA_MODO: ia | regra | alternar (metade das etapas com a IA e metade com a regra, para comparar)
IA_URL=http://ia:5000
IA_TIMEOUT=1.5
IA_MODO=ia
